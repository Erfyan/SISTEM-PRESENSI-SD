# Dependencies
/node_modules
/vendor

# Environment & Credentials
.env
.env.*
!.env.example
/auth.json
/storage/*.key

# SQLite Database & Local Dumps
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
/database/*.sqlite-journal
/database/*.sqlite-wal
/database/*.sqlite-shm
/storage/app/backups/*
!/storage/app/backups/.gitignore

# Build & Frontend Assets
/public/build
/public/hot
/public/storage
/.vite
/dev-dist

# Storage & Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/storage/logs/*
!/storage/logs/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/pail

# Testing & Code Analysis
.phpunit.result.cache
/.phpunit.cache
.php-cs-fixer.cache
.phpactor.json

# IDE & Editor Configs
/.fleet
/.idea
/.nova
/.vscode
/.zed
*.suo
*.ntvs*
